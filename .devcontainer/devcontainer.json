{
  "name": "android",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/jakobmelchard/devcontainer/ws:1": {},
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    },
    "ghcr.io/jakobmelchard/devcontainer/android:1": {}
  },
  "postCreateCommand": "prek install",
  "customizations": {
    "codespaces": {
      "repositories": {
        "JakobMelchard/.githooks": {
          "permissions": {
            "contents": "read"
          }
        },
        "JakobMelchard/.config": {
          "permissions": {
            "contents": "read"
          }
        }
      }
    }
  }
}
